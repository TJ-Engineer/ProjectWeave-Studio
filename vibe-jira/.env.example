POSTGRES_DB=vibe_jira
POSTGRES_USER=vibe
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://vibe:replace-with-a-long-random-password@postgres:5432/vibe_jira
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=false
PUBLIC_URL=http://localhost:3000
ALLOW_PASSWORD_AUTH=true
LOGIN_RATE_LIMIT_MAX=10
# OIDC_ISSUER=https://identity.example.com
# OIDC_CLIENT_ID=vibe-jira
# OIDC_CLIENT_SECRET=replace-with-provider-client-secret
# OIDC_ALLOWED_DOMAIN=example.com
OIDC_AUTO_PROVISION=false
DEMO_ADMIN_EMAIL=admin@vibe.local
DEMO_ADMIN_PASSWORD=replace-with-at-least-12-characters
DEMO_MEMBER_EMAIL=member@vibe.local
DEMO_MEMBER_PASSWORD=replace-with-at-least-12-characters
DEMO_VIEWER_EMAIL=viewer@vibe.local
DEMO_VIEWER_PASSWORD=replace-with-at-least-12-characters
PORT=3000
APP_VERSION=development
APP_REVISION=unknown
# METRICS_TOKEN=replace-with-a-monitoring-bearer-token
OBJECT_STORAGE_ENDPOINT=http://object-storage:8333
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vibe-jira-attachments
OBJECT_STORAGE_ACCESS_KEY=replace-with-an-object-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-object-storage-secret
OBJECT_STORAGE_PORT=8333
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
OUTBOX_POLL_MS=1000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_HEALTH_MAX_AGE_SECONDS=120
